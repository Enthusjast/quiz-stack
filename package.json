{
  "name": "quiz-stack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:data && vue-tsc -b && npm run build-only",
    "build-only": "vite build && node scripts/generate-service-worker.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate:data": "node scripts/validate-banks.mjs",
    "typecheck": "vue-tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lucide/vue": "^1.21.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.24",
    "tailwindcss": "^3.4.19",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}
